{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zplanner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zplanner",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
