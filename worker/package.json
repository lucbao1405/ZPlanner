{
  "name": "zplanner-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "db:apply:local": "wrangler d1 migrations apply zplanner --local",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
