<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/zp_surface_alt" />
            <stroke android:width="1.5dp" android:color="@color/zp_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/zp_secondary_bg" />
            <stroke android:width="1.5dp" android:color="@color/zp_secondary_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
