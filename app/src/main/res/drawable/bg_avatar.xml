<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/zp_surface_alt" />
            <stroke android:width="2dp" android:color="@color/zp_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/zp_surface_alt" />
            <stroke android:width="1dp" android:color="@color/zp_border" />
        </shape>
    </item>
</selector>