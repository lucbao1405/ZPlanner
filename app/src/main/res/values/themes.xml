<resources>
    <!-- Runtime theme. Preview uses the explicit light variant below so the Layout Editor
         does not inherit its own (possibly dark) editor/night mode defaults. -->
    <style name="Theme.ZPlanner" parent="android:style/Theme.Material.Light.NoActionBar">
        <!-- Keep the preview theme API-compatible with the runtime theme. -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/zp_background</item>
        <item name="android:colorBackground">@color/zp_background</item>
        <item name="android:textColorPrimary">@color/zp_text</item>
        <item name="android:textColorSecondary">@color/zp_muted</item>
        <item name="android:colorAccent">@color/zp_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/zp_background</item>
        <item name="android:navigationBarColor">@color/zp_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Layout Editor-only theme: explicit light colors prevent a dark editor mode from
         making XML previews appear black. This is never applied at runtime. -->
    <style name="Theme.ZPlanner.Preview" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/zp_background</item>
        <item name="android:colorBackground">@color/zp_background</item>
        <item name="android:textColorPrimary">@color/zp_text</item>
        <item name="android:textColorSecondary">@color/zp_muted</item>
        <item name="android:colorAccent">@color/zp_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/zp_background</item>
        <item name="android:navigationBarColor">@color/zp_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>