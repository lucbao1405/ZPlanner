<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:theme="@style/Theme.ZPlanner.Preview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle_primary"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/zp_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_title"
                android:textColor="@color/zp_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_edit_subtitle"
                android:textColor="@color/zp_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Avatar Upload Container with Camera Overlay Badge -->
    <RelativeLayout
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/imgProfileAvatarPreview"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_avatar_ring"
            android:contentDescription="@string/avatar_description"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_default" />

        <ImageButton
            android:id="@+id/btnChangeAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_primary_button"
            android:contentDescription="@string/change_avatar"
            android:elevation="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:tint="@color/zp_on_primary" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/change_avatar_hint"
        android:textColor="@color/zp_muted"
        android:textSize="12sp" />

    <!-- Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/name_label"
        android:textColor="@color/zp_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtProfileName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:autofillHints="name"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_person"
        android:drawablePadding="10dp"
        android:drawableTint="@color/zp_muted"
        android:hint="@string/name_hint"
        android:inputType="textPersonName|textCapWords"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/zp_text"
        android:textColorHint="@color/zp_muted"
        android:textSize="15sp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btnCancelProfile"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:minWidth="88dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/zp_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_primary_button"
            android:minWidth="120dp"
            android:paddingHorizontal="20dp"
            android:text="@string/save_changes"
            android:textAllCaps="false"
            android:textColor="@color/zp_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
