<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_task_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Time & Event Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtEventTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/zp_event_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="📅 2025-05-20 09:00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_event"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minWidth="48dp"
            android:gravity="center"
            android:text="@string/event_label"
            android:textColor="@color/zp_event_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Row: Title, Description, Location & Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/zp_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Sự kiện ra mắt ZPlanner" />

            <TextView
                android:id="@+id/txtEventDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/zp_muted"
                android:textSize="13sp"
                tools:text="Gặp gỡ toàn bộ thành viên trong đội phát triển" />

            <TextView
                android:id="@+id/txtEventLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/zp_primary"
                android:textSize="13sp"
                tools:text="📍 Phòng họp A1 - Tầng 3" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditEvent"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_btn_edit"
            android:contentDescription="@string/edit"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/zp_primary" />

        <ImageButton
            android:id="@+id/btnDeleteEvent"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn_delete"
            android:contentDescription="@string/delete"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/zp_danger" />
    </LinearLayout>
</LinearLayout>
