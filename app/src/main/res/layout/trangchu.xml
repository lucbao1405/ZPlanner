<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity"
    tools:theme="@style/Theme.ZPlanner.Preview"
    tools:background="@color/zp_background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/zp_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/zp_screen_padding">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZPlanner ✦" android:textColor="@color/zp_primary" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Kế hoạch của bạn" android:textColor="@color/zp_text" android:textSize="26sp" android:textStyle="bold"/>
                </LinearLayout>
                <ImageButton android:id="@+id/btnSettings" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Mở cài đặt" android:src="@android:drawable/ic_menu_preferences" android:tint="@color/zp_primary"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_hero" android:orientation="vertical" android:elevation="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hôm nay của bạn" android:textColor="#EDE8FF" android:textSize="14sp"/>
                <TextView android:id="@+id/txtProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hoàn thành 0/0 công việc trong ngày" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                <ProgressBar android:id="@+id/progressDay" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="16dp" android:max="1" android:progressTint="#FFFFFF" android:progressBackgroundTint="#8E78E5"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:gravity="center_vertical">
                <Button android:id="@+id/btnPreviousDay" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:text="‹" android:textColor="@color/zp_primary" android:textSize="28sp" android:contentDescription="Ngày trước"/>
                <TextView android:id="@+id/txtSelectedDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Hôm nay" android:textColor="@color/zp_text" android:textSize="16sp" android:textStyle="bold"/>
                <Button android:id="@+id/btnNextDay" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:text="›" android:textColor="@color/zp_primary" android:textSize="28sp" android:contentDescription="Ngày tiếp theo"/>
            </LinearLayout>
            <TextView android:id="@+id/txtTaskError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/zp_danger" android:visibility="gone"/>
            <ProgressBar android:id="@+id/progressTasks" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:layout_marginTop="16dp" android:indeterminateTint="@color/zp_primary" android:visibility="gone"/>
            <TextView android:id="@+id/txtEmptyTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:padding="24dp" android:text="Chưa có công việc.\nThêm một việc nhỏ để bắt đầu nhé ✨" android:textColor="@color/zp_muted" android:textSize="15sp"/>
            <LinearLayout android:id="@+id/taskList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnAddTask" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_primary_button" android:text="＋  Thêm công việc" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_bottom_nav" android:elevation="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nTrang chủ" android:textColor="@color/zp_primary" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:text="●\nCá nhân" android:textColor="@color/zp_muted" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>