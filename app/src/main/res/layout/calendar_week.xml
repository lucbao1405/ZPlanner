<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity"
    tools:theme="@style/Theme.ZPlanner.Preview"
    tools:background="@color/zp_background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/zp_background" android:padding="@dimen/zp_screen_padding">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lịch tuần" android:textColor="@color/zp_text" android:textSize="26sp" android:textStyle="bold"/>
 <TextView android:id="@+id/txtWeekRange" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/zp_muted"/>
 <LinearLayout android:id="@+id/weekDays" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="16dp" android:orientation="horizontal"/>
 <TextView android:id="@+id/txtCalendarDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/zp_text" android:textSize="17sp" android:textStyle="bold"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/calendarTaskList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
 <Button android:id="@+id/btnCalendarBack" android:layout_width="match_parent" android:layout_height="52dp" android:text="‹  Trang chủ" android:textAllCaps="false"/>
</LinearLayout>