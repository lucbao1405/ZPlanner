<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:theme="@style/Theme.ZPlanner.Preview"
    tools:background="@color/zp_surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logout_title"
        android:textColor="@color/zp_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/logout_message"
        android:textColor="@color/zp_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelLogout"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/stay"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnConfirmLogout"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/zp_danger"
            android:text="@string/logout"
            android:textAllCaps="false"
            android:textColor="@color/zp_on_primary" />
    </LinearLayout>
</LinearLayout>