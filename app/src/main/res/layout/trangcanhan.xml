<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity"
    tools:theme="@style/Theme.ZPlanner.Preview"
    tools:background="@color/zp_background"
    tools:showIn="@layout/trangcanhan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/zp_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/btnProfileBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:padding="12dp"
            android:tint="@color/zp_primary"
            android:contentDescription="Quay lại" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cá nhân"
            android:textColor="@color/zp_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/btnProfileSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_settings" android:padding="12dp"
            android:tint="@color/zp_primary"
            android:contentDescription="Mở cài đặt" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cá nhân"
                android:textColor="@color/zp_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="LB"
                    android:textColor="@color/zp_profile_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lục Bảo"
                        android:textColor="@color/zp_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/zp_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Chỉnh sửa hồ sơ"
                        android:textColor="@color/zp_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Tài khoản"
                android:textColor="@color/zp_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:id="@+id/btnEditProfile"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableTint="@color/zp_primary"
                    android:drawablePadding="14dp"
                    android:text="Chỉnh sửa thông tin cá nhân"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:id="@+id/btnManageCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableTint="@color/zp_primary"
                    android:drawablePadding="14dp"
                    android:text="Quản lý lịch và nhiệm vụ"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Tùy chỉnh ứng dụng"
                android:textColor="@color/zp_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawableTint="@color/zp_primary"
                    android:drawablePadding="14dp"
                    android:text="Giao diện tối"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:id="@+id/btnReminders"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_task"
                    android:drawableTint="@color/zp_primary"
                    android:drawablePadding="14dp"
                    android:text="Nhắc nhở công việc"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="⌁   Ngày bắt đầu tuần                                      Thứ Hai"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Hỗ trợ"
                android:textColor="@color/zp_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnHelp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_help"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableTint="@color/zp_primary"
                    android:drawablePadding="14dp"
                    android:text="Trung tâm trợ giúp"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:id="@+id/btnAbout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_info"
                    android:drawableTint="@color/zp_primary"
                    android:drawablePadding="14dp"
                    android:text="Về ZPlanner  ·  v1.0"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLogoutProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:clickable="true"
                android:text="Đăng xuất"
                android:textColor="@color/zp_danger"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/zp_surface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="@color/zp_nav_muted"
            android:drawablePadding="2dp"
            android:text="@string/home_label"
            android:textColor="@color/zp_nav_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_calendar"
            android:drawableTint="@color/zp_nav_muted"
            android:drawablePadding="2dp"
            android:text="@string/calendar_label"
            android:textColor="@color/zp_nav_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_task"
            android:drawableTint="@color/zp_nav_muted"
            android:drawablePadding="2dp"
            android:text="@string/tasks_label"
            android:textColor="@color/zp_nav_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_person"
            android:drawableTint="@color/zp_primary"
            android:drawablePadding="2dp"
            android:text="@string/profile_label"
            android:textColor="@color/zp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>