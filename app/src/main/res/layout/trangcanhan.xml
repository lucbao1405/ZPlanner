<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity"
    tools:theme="@style/Theme.ZPlanner.Preview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/zp_background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnProfileBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:padding="10dp"
            android:tint="@color/zp_primary"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cá nhân"
            android:textColor="@color/zp_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Profile Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgProfileAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:contentDescription="Ảnh đại diện"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_default" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/zp_text"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="Lục Bảo" />

                    <TextView
                        android:id="@+id/txtProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/zp_muted"
                        android:textSize="13sp"
                        tools:text="you@example.com" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="✎ Chỉnh sửa hồ sơ"
                        android:textColor="@color/zp_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 1: Account -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tài khoản"
                android:textColor="@color/zp_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/zp_primary"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Chỉnh sửa thông tin cá nhân"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:id="@+id/btnManageCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/zp_primary"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Quản lý lịch và nhiệm vụ"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Section 2: Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Cài đặt và tùy chỉnh"
                android:textColor="@color/zp_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <Switch
                    android:id="@+id/btnDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:buttonTint="@color/zp_primary"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="Giao diện tối"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <Switch
                    android:id="@+id/btnReminders"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:buttonTint="@color/zp_primary"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="Nhắc nhở công việc"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/zp_primary"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Ngày bắt đầu tuần  ·  Thứ Hai"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Section 3: Support -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Hỗ trợ"
                android:textColor="@color/zp_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnHelp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_help"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/zp_primary"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Trung tâm trợ giúp"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/zp_divider" />

                <TextView
                    android:id="@+id/btnAbout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_info"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/zp_primary"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Về ZPlanner  ·  v1.0"
                    android:textColor="@color/zp_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Logout Button -->
            <TextView
                android:id="@+id/btnLogoutProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="Đăng xuất"
                android:textColor="@color/zp_danger"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/zp_surface"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="@color/zp_nav_muted"
            android:drawablePadding="2dp"
            android:text="@string/home_label"
            android:textColor="@color/zp_nav_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_calendar"
            android:drawableTint="@color/zp_nav_muted"
            android:drawablePadding="2dp"
            android:text="@string/calendar_label"
            android:textColor="@color/zp_nav_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_task"
            android:drawableTint="@color/zp_nav_muted"
            android:drawablePadding="2dp"
            android:text="@string/tasks_label"
            android:textColor="@color/zp_nav_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_nav_item"
            android:drawableTop="@drawable/ic_person"
            android:drawableTint="@color/zp_primary"
            android:drawablePadding="2dp"
            android:text="@string/profile_label"
            android:textColor="@color/zp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
